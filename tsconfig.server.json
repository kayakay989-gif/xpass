{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "server.ts",
    "backend/**/*",
    "lib/firebase.ts",
    "lib/firestore.ts",
    "lib/config.ts",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    "app/**/*",
    "components/**/*",
    "contexts/**/*",
    "**/*.test.ts",
    "**/*.spec.ts",
    "lib/trpc.ts"
  ]
}

