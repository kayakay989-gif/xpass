        {
          "cameraPermission": "Xpass uses the camera to scan QR codes at partner gyms when you check in. For example, you will point the camera at the gym check-in QR code so we can confirm your active subscription and record your visit.",
          "microphonePermission": "Xpass uses the microphone only when you record video with the in-app camera, so your clip can include sound (for example, a short video at the gym).",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
